#!/usr/bin/env python3

import json
from argparse import ArgumentParser

from esbuild.export import mapping_exporter
from esbuild.graph.active.builder import ActiveGraphIndexBuilder
from esbuild.gdc_elasticsearch import GDCElasticsearch
from esbuild.utils import (
    VersionedNodesDiffCollector,
    force_merge_indices,
    get_elasticsearch_client,
)


def handle_mappings(args):
    exporter = mapping_exporter.MappingExporter()
    exporter.export(args.output_dir)


def handle_reindex(args):
    gdc_es = GDCElasticsearch(ActiveGraphIndexBuilder, indexd_client=None)
    gdc_es.reindex(args.old_index, args.new_index, index_types=args.index_types,
                   project_ids=args.project_ids)


def handle_pre_flight(args):
    collector = VersionedNodesDiffCollector(project_ids=args.project_ids)
    diffs = collector.collect_differences()

    if args.out_file:
        with open(args.out_file, 'w') as f:
            json.dump(diffs, f, indent=2)
    else:
        print(json.dumps(diffs, indent=2))


def handle_force_merge(args):
    es = get_elasticsearch_client()
    force_merge_indices(es, args.index_prefix, args.index_names)


def get_parser():
    parser = ArgumentParser()

    subparser = parser.add_subparsers(title='subcommands')

    mappings_sub = subparser.add_parser(
        'mappings',
        description=mapping_exporter.MappingExporter.__doc__,
        help=mapping_exporter.MappingExporter.__doc__
    )
    mappings_sub.add_argument(
        '-o',
        '--output-dir',
        default='mappings',
        help='Directory to which to write the new mappings (./mappings by default)',
    )
    mappings_sub.set_defaults(func=handle_mappings)

    reindex_sub = subparser.add_parser(
        'reindex',
        description=GDCElasticsearch.reindex.__doc__,
        help=GDCElasticsearch.reindex.__doc__
    )
    reindex_sub.add_argument(
        '--old-index',
        required=True,
        help='The name or alias of an existing Elasticsearch index that needs '
             'reindexing',
    )
    reindex_sub.add_argument(
        '--new-index',
        required=True,
        help='The name of a destination Elasticsearch index'
    )
    reindex_sub.add_argument(
        '--index-types',
        required=False,
        nargs='*',
        default=(),
        help='Elasticsearch document types to reindex',
    )
    reindex_sub.add_argument(
        "--project-ids",
        required=False,
        nargs="+",
        default=(),
        help="List of space separated projects to reindex",
    )
    reindex_sub.set_defaults(func=handle_reindex)

    preflight_sub = subparser.add_parser(
        'pre-flight',
        description=VersionedNodesDiffCollector.__doc__,
        help=VersionedNodesDiffCollector.__doc__
    )
    preflight_sub.add_argument(
        '-p', '--project_ids',
        nargs='+',
        required=False,
        help='Projects to run the pre-flight for',
    )
    preflight_sub.add_argument(
        '-o', '--out-file',
        metavar='FILE',
        required=False,
        help='Output file for the metadata differences.'
    )
    preflight_sub.set_defaults(func=handle_pre_flight)

    fm_sub = subparser.add_parser(
        "force-merge",
        description=force_merge_indices.__doc__,
        help=force_merge_indices.__doc__
    )
    fm_indices_group = fm_sub.add_mutually_exclusive_group()
    fm_indices_group.add_argument(
        "--index-prefix",
        required=False,
        help="ES index prefix (e.g. release_dr25_graph)",
    )
    fm_indices_group.add_argument(
        "--index-names",
        required=False,
        help="ES index names to force merge",
    )
    fm_sub.set_defaults(func=handle_force_merge)

    # TODO: Add more params as needed.

    return parser


if __name__ == '__main__':
    args = get_parser().parse_args()
    try:
        args.func(args)
    except AttributeError:
        get_parser().print_help()
