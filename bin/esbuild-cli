import json
from argparse import ArgumentParser
from pprint import pformat

from esbuild.graph.active.builder import ActiveGraphIndexBuilder
from esbuild.gdc_elasticsearch import GDCElasticsearch
from esbuild.utils import VersionedNodesCacher


def handle_reindex(args):
    gdc_es = GDCElasticsearch(ActiveGraphIndexBuilder, None)
    gdc_es.reindex(args.old_index, args.new_index, types=args.doc_types)


def handle_pre_flight(args):
    cacher = VersionedNodesCacher(project_ids=args.project_ids)
    cacher.cache_versioned_nodes()

    if args.file_out:
        with open(args.file_out) as f:
            json.dump(cacher.the_cache, f, indent=2)
    else:
        print(pformat(cacher.the_cache))


def get_parser():
    parser = ArgumentParser()

    subparser = parser.add_subparsers(title='subcommands')

    reindex_sub = subparser.add_parser('reindex')
    reindex_sub.add_argument(
        '--old-index',
        required=True,
        help='The name or alias of an existing Elasticsearch index that needs '
             'reindexing',
    )
    reindex_sub.add_argument(
        '--new-index',
        required=True,
        help='The name of a destination Elasticsearch index'
    )
    reindex_sub.add_argument(
        '--doc-types',
        required=False,
        nargs='*',
        default=(),
        help='Elasticsearch document types to reindex',
    )
    reindex_sub.set_defaults(func=handle_reindex)

    preflight_sub = subparser.add_parser('pre-flight')
    preflight_sub.add_argument(
        '-p', '--project_ids',
        nargs='+',
        required=True,
        help='Projects to run the pre-flight for',
    )
    preflight_sub.add_argument(
        '-f', '--file-out',
        metavar='FILE',
        required=False,
        help='Output file for the metadata differences.'
    )
    preflight_sub.set_defaults(func=handle_pre_flight)

    # TODO: Add more params as needed.

    return parser


if __name__ == '__main__':
    args = get_parser().parse_args()
    args.func(args)
