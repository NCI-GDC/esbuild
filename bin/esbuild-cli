#!/usr/bin/env python3

import argparse
import json

import datadog
from esbuild import utils, reindexing, gdc_elasticsearch
from esbuild.export import mapping_exporter
from concurrent import futures


def handle_mappings(args):
    exporter = mapping_exporter.MappingExporter()
    exporter.export(args.output_dir)


def handle_reindex(args):
    es = utils.get_elasticsearch_client()
    helper = utils.ReleaseHelper(es, "build_metadata", True)
    event_logger = reindexing.EventLogger(datadog.statsd)

    with futures.ThreadPoolExecutor() as executor:
        task_factory = gdc_elasticsearch.TaskFactory(es, executor)
        progress_manager = reindexing.TaskProgressManager(task_factory, event_logger)
        reindexer = reindexing.Reindexer(
            es, helper, progress_manager, event_logger, executor
        )

        reindexer.reindex(
            old_index=args.old_index,
            new_index=args.new_index,
            index_types=args.index_types,
            project_ids=args.project_ids,
            conflicts=args.conflicts,
            query=args.query,
            script=args.script,
            script_language=args.script_language,
        )


def handle_pre_flight(args: argparse.Namespace) -> None:
    """Handle the pre-flight command.

    This function collects differences between corresponding new and old version
    of files and documents their differences in the specified output file.
    """
    gencode_versions = utils.get_all_gencode_versions(args.gencode_version)
    collector = utils.VersionedNodesDiffCollector(
        project_ids=args.project_ids, allowed_gencode_versions=gencode_versions
    )
    diffs = collector.collect_differences()

    if args.out_file:
        with open(args.out_file, "w") as f:
            json.dump(diffs, f, indent=2)
    else:
        print(json.dumps(diffs, indent=2))


def handle_force_merge(args):
    es = utils.get_elasticsearch_client()
    utils.force_merge_indices(es, args.index_prefix, args.index_names)


def get_parser() -> argparse.ArgumentParser:
    """Build and return the ArgumentParser for esbuild-cli."""
    parser = argparse.ArgumentParser()

    subparser = parser.add_subparsers(title="subcommands")

    # MAPPINGS
    mappings_sub = subparser.add_parser(
        "mappings", help=mapping_exporter.MappingExporter.__doc__
    )
    mappings_sub.add_argument(
        "-o",
        "--output-dir",
        default="mappings",
        help="Directory to which to write the new mappings (./mappings by default)",
    )
    mappings_sub.set_defaults(func=handle_mappings)

    # REINDEX
    reindex_sub = subparser.add_parser(
        "reindex", help="A command for calling Elasticsearch's reindex API."
    )
    reindex_sub.add_argument(
        "--old-index",
        required=True,
        help="The name or alias of an existing Elasticsearch index that needs "
        "reindexing",
    )
    reindex_sub.add_argument(
        "--new-index",
        required=True,
        help="The name of a destination Elasticsearch index",
    )
    reindex_sub.add_argument(
        "--index-types",
        required=False,
        nargs="*",
        default=(),
        help="Elasticsearch document types to reindex",
    )
    reindex_sub.add_argument(
        "--project-ids",
        required=False,
        nargs="+",
        default=(),
        help="List of space separated projects to reindex",
    )
    reindex_sub.add_argument(
        "--conflicts",
        required=False,
        default="abort",
        choices=("proceed", "abort"),
        help="Set to proceed to continue reindexing even if there are conflicts. Defaults to abort.",
    )
    reindex_sub.add_argument(
        "--query",
        required=False,
        help="A file containing a query to determine what is pulled from the source index.",
    )
    reindex_sub.add_argument(
        "--script",
        required=False,
        help="A file containing a script to be run during the execution of the reindexing process.",
    )
    reindex_sub.add_argument(
        "--script-language",
        required=False,
        help="The language of the script that was provided if any.",
    )
    reindex_sub.set_defaults(func=handle_reindex)

    # PRE-FLIGHT
    preflight_sub = subparser.add_parser(
        "pre-flight", help=utils.VersionedNodesDiffCollector.__doc__
    )
    preflight_sub.add_argument(
        "-p",
        "--project_ids",
        nargs="+",
        required=False,
        help="Projects to run the pre-flight for",
    )
    preflight_sub.add_argument(
        "--gencode-version",
        help="Set desired gencode_version for indexing, 'neutral' nodes are always included. "
        "If not set, all available nodes will be included.",
        type=str,
        default="all",
        choices=["v22", "v36", "all"],
    )
    preflight_sub.add_argument(
        "-o",
        "--out-file",
        metavar="FILE",
        required=False,
        help="Output file for the metadata differences.",
    )
    preflight_sub.set_defaults(func=handle_pre_flight)

    # FORCE-MERGE
    fm_sub = subparser.add_parser("force-merge", help=utils.force_merge_indices.__doc__)
    fm_indices_group = fm_sub.add_mutually_exclusive_group()
    fm_indices_group.add_argument(
        "--index-prefix",
        required=False,
        help="ES index prefix (e.g. release_dr25_graph)",
    )
    fm_indices_group.add_argument(
        "--index-names",
        required=False,
        help="ES index names to force merge",
    )
    fm_sub.set_defaults(func=handle_force_merge)

    # TODO: Add more params as needed.

    return parser


if __name__ == "__main__":
    args = get_parser().parse_args()
    try:
        args.func(args)
    except AttributeError:
        get_parser().print_help()
